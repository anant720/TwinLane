# TwinLane Environment Variables Template
# Copy this file to .env and fill in values. NEVER COMMIT .env

# LLM Provider Configuration
TWINLANE_LLM_PROVIDER=mock # mock | gemini | ollama
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Gate Configuration
TWINLANE_MODE=balanced # strict | balanced | observe
TWINLANE_POLICY_PATH=src/twinlane/policy/rules/default.yaml
TWINLANE_AUDIT_LOG_PATH=audit.jsonl

# Agent Key Paths
TWINLANE_KEY_DIR=.twinlane_keys/

